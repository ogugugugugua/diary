{
  "name": "xingji-family-journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "node --import tsx server/dev.ts",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "pretest": "node scripts/prepare-assets.mjs",
    "test": "node --import tsx tests/run.ts",
    "check": "tsc --noEmit",
    "test:browser": "node tests/run-browser.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "exifr": "^7.1.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0",
    "playwright-core": "^1.51.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
